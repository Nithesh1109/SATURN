# SATURN cloud AI configuration
# Copy this file to .env only if you use an environment loader, or export these
# variables in your shell. Never commit the real API key.

# Required for cloud text and vision testing.
NVIDIA_API_KEY=

# Text model used by the SATURN planner.
SATURN_CLOUD_MODEL=meta/llama-3.1-8b-instruct
SATURN_CLOUD_ENDPOINT=https://integrate.api.nvidia.com/v1/chat/completions

# Vision model used for screenshot understanding.
SATURN_VISION_MODEL=meta/llama-3.2-90b-vision-instruct
SATURN_VISION_ENDPOINT=https://integrate.api.nvidia.com/v1/chat/completions

# Optional local Core API authentication. If set, clients must send
# Authorization: Bearer <token>.
SATURN_API_TOKEN=
